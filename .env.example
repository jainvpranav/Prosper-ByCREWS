# =============================================================================
# PROSPER HEALTH — Environment Variables Template
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# =============================================================================

# --- AWS RDS (SQL Server) Connection ---
# Find your endpoint in: AWS Console → RDS → Databases → your-instance → Connectivity
DB_HOST=your-rds-instance.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=1433
DB_NAME=ProsperDB
DB_USER=prosper_app_user
DB_PASSWORD=CHANGE_ME_strong_password

# Force SSL/TLS in transit (HIPAA §164.312(e)(2)(ii) — Encryption in transit)
# Keep this TRUE always for HIPAA compliance. Do NOT set to false.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false

# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=30000

# --- Application-Layer PHI Encryption ---
# AES-256 key used by the app to encrypt sensitive PHI before writing to DB.
# Must be exactly 32 bytes (256 bits) encoded as hex (64 hex chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHI_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_here

# IV is auto-generated per record but you need a stable HMAC key for search tokens
PHI_HMAC_KEY=CHANGE_ME_another_64_hex_chars_here

# --- Gemini / AI ---
GEMINI_API_KEY=CHANGE_ME

# --- Next.js App ---
NEXTAUTH_SECRET=CHANGE_ME_random_secret
NEXTAUTH_URL=http://localhost:3000

# --- AWS General (if using S3, KMS, CloudWatch, etc.) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# KMS Key ARN for RDS TDE / Secrets Manager
AWS_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/CHANGE_ME

NEXT_PUBLIC_CHAT_API_URL=https://CHANGE_ME.execute-api.ap-south-1.amazonaws.com/Pilot/chat
