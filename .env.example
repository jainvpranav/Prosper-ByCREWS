# =============================================================================
# PROSPER HEALTH — Environment Variables Template
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# =============================================================================


# --- AWS General (if using S3, KMS, CloudWatch, etc.) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# KMS Key ARN for RDS TDE / Secrets Manager
AWS_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/CHANGE_ME

NEXT_PUBLIC_CHAT_API_URL=https://CHANGE_ME.execute-api.ap-south-1.amazonaws.com/Pilot/chat

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://CHANGE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=CHANGE_ME

# --- Cardiac Classifier (FastAPI on Lambda) ---
CLASSIFIER_API_URL=https://CHANGE_ME.execute-api.ap-south-1.amazonaws.com/predict